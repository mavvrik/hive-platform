// HIVE Platform Enterprise
// Enterprise Foundation E1.0.3

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENTERPRISE STRUCTURE
// ======================================================

model Organization {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique
  description String?
  isActive    Boolean @default(true)

  regions Region[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Region {
  id          String  @id @default(cuid())
  name        String
  key         String
  description String?
  isActive    Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  centers Center[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Center {
  id           String @id @default(cuid())
  centerNumber String @unique
  name         String
  displayName  String
  slug         String @unique

  // Existing text region column is preserved during migration.
  regionLegacy String? @map("region")

  state    String?
  country  String  @default("US")
  timezone String
  isActive Boolean @default(true)

  // New enterprise Region relationship.
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  // Existing identityId database column is preserved.
  experienceId String?     @map("identityId")
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  homeWorkers Worker[]           @relation("WorkerHomeCenter")
  assignments WorkerAssignment[]
  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([experienceId])
  @@map("PlatformCenter")
}

model Department {
  id          String  @id @default(cuid())
  name        String
  key         String
  description String?
  isActive    Boolean @default(true)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  activities WorkerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, key])
  @@index([centerId])
}

// ======================================================
// CENTER EXPERIENCE ENGINE
// ======================================================

model Experience {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique
  description String?

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  greeting String?
  version  Int     @default(1)

  centers Center[]

  branding    ExperienceBranding?
  terminology ExperienceTerminology[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PlatformIdentity")
}

model ExperienceBranding {
  id String @id @default(cuid())

  experienceId String     @unique @map("identityId")
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  primaryColor   String?
  secondaryColor String?
  accentColor    String?

  logoUrl       String?
  mascotUrl     String?
  backgroundUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("IdentityBranding")
}

model ExperienceTerminology {
  id String @id @default(cuid())

  experienceId String     @map("identityId")
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  termKey      String
  displayValue String
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([experienceId, termKey])
  @@index([experienceId])
  @@map("IdentityTerminology")
}

// ======================================================
// WORKFORCE
// ======================================================

model Worker {
  id          String  @id @default(cuid())
  employeeId  String? @unique
  firstName   String
  lastName    String
  displayName String

  email    String?
  photoUrl String?
  hireDate DateTime?
  isActive Boolean   @default(true)

  // Preserve the existing centerId column as the worker's
  // current/home center while assignment history is introduced.
  homeCenterId String @map("centerId")
  homeCenter   Center @relation("WorkerHomeCenter", fields: [homeCenterId], references: [id])

  assignments  WorkerAssignment[]
  roles        WorkerRole[]
  capabilities WorkerCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([homeCenterId])
  @@map("PlatformPerson")
}

// Keeps a worker's center/department history over time.
model WorkerAssignment {
  id String @id @default(cuid())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  startDate DateTime
  endDate   DateTime?
  isPrimary Boolean   @default(true)
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([centerId])
  @@index([departmentId])
  @@index([workerId, startDate])
}

model Role {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique
  description String?
  isActive    Boolean @default(true)

  workers WorkerRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PlatformRole")
}

model Capability {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique
  description String?
  isActive    Boolean @default(true)

  workers WorkerCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PlatformCapability")
}

model WorkerRole {
  id String @id @default(cuid())

  workerId String @map("personId")
  roleId   String

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workerId, roleId])
  @@map("PersonRole")
}

model WorkerCapability {
  id String @id @default(cuid())

  workerId     String @map("personId")
  capabilityId String

  worker     Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workerId, capabilityId])
  @@map("PersonCapability")
}

// ======================================================
// SECURITY FOUNDATION
// ======================================================

model Permission {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PlatformPermission")
}
